# Copy to .env (never commit .env). Paper/dry-run only; no keys needed today.
MODE=dry_run
LIVE_APPROVED=0
# Future trade-only (NO withdraw) sub-account key, provided only via secure secret form:
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
TELEGRAM_BOT_TOKEN=

# Optional live confirm alias. Live mode stays refused until every gate passes.
LIVE_CONFIRM=
# OKX demo-trading key (read+trade, no withdraw). Enter via the secret form, never chat.
OKX_DEMO_API_KEY=
OKX_DEMO_API_SECRET=
OKX_DEMO_API_PASSPHRASE=
