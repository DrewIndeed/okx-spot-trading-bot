diff --git a/tests/test_tgbot.py b/tests/test_tgbot.py
new file mode 100644
index 0000000..af1aa78
--- /dev/null
+++ b/tests/test_tgbot.py
@@ -0,0 +1,135 @@
+"""Telegram command bot: routing, allow-list, locking. No network, no real CLI."""
+from __future__ import annotations
+
+import subprocess
+import threading
+import time
+
+import pytest
+
+from tradingbot import tgbot
+
+
+@pytest.fixture
+def sent(monkeypatch):
+    msgs: list[tuple[str, str]] = []
+    monkeypatch.setattr(tgbot, "_send", lambda token, chat, text: msgs.append((str(chat), text)))
+    return msgs
+
+
+def _wait_unlocked(lock: threading.Lock, secs: float = 3.0) -> None:
+    end = time.time() + secs
+    while lock.locked() and time.time() < end:
+        time.sleep(0.01)
+    assert not lock.locked()
+
+
+def test_command_table_has_no_telegram_builtin_clash():
+    # /start is Telegram's built-in; loop control must use different names.
+    assert "start" not in tgbot.COMMANDS and "stop" not in tgbot.COMMANDS
+    assert tgbot.COMMANDS["startloop"][0][0] == "paper-start"
+    assert tgbot.COMMANDS["stoploop"][0][0] == "paper-stop"
+    assert tgbot.COMMANDS["stoploop"][1] is False  # quick: must work while /sync runs
+
+
+def test_help_replies_without_running_cli(monkeypatch, sent):
+    monkeypatch.setattr(tgbot, "_safe_cli", lambda *a, **k: pytest.fail("cli must not run"))
+    tgbot._handle("t", "1", "/help", threading.Lock())
+    assert len(sent) == 1 and "/status" in sent[0][1] and "/startloop" in sent[0][1]
+
+
+def test_non_command_ignored_and_unknown_gets_menu(monkeypatch, sent):
+    monkeypatch.setattr(tgbot, "_safe_cli", lambda *a, **k: pytest.fail("cli must not run"))
+    lock = threading.Lock()
+    tgbot._handle("t", "1", "hello", lock)
+    assert sent == []
+    tgbot._handle("t", "1", "/rm_rf", lock)
+    assert "Unknown command" in sent[0][1]
+
+
+def test_bot_suffix_and_case_are_stripped(monkeypatch, sent):
+    calls = []
+    monkeypatch.setattr(tgbot, "_safe_cli", lambda args, timeout: calls.append(args) or "ok")
+    tgbot._handle("t", "1", "/STATUS@MyBot", threading.Lock())
+    assert calls == [["paper-status"]] and sent[-1][1] == "ok"
+
+
+def test_quick_command_timeout_becomes_message(monkeypatch, sent):
+    def boom(*a, **k):
+        raise subprocess.TimeoutExpired(cmd="x", timeout=1)
+
+    monkeypatch.setattr(tgbot, "_cli", boom)
+    tgbot._handle("t", "1", "/summary", threading.Lock())
+    assert "timed out" in sent[-1][1]
+
+
+def test_long_command_runs_in_worker_and_releases_lock(monkeypatch, sent):
+    calls = []
+    monkeypatch.setattr(tgbot, "_safe_cli", lambda args, timeout: calls.append((args, timeout)) or "done")
+    lock = threading.Lock()
+    tgbot._handle("t", "1", "/startloop", lock)
+    _wait_unlocked(lock)
+    assert calls == [(tgbot.COMMANDS["startloop"][0], tgbot.LONG_TIMEOUT)]
+    assert sent[0][1].startswith("running /startloop") and sent[-1][1] == "done"
+
+
+def test_second_long_command_is_rejected_while_busy(monkeypatch, sent):
+    monkeypatch.setattr(tgbot, "_safe_cli", lambda *a, **k: pytest.fail("must not run"))
+    lock = threading.Lock()
+    lock.acquire()
+    tgbot._handle("t", "1", "/sync", lock)
+    assert "busy" in sent[0][1] and "not started" in sent[0][1]
+    assert lock.locked()  # still held by the "other" job
+
+
+def test_lock_released_if_announce_fails(monkeypatch):
+    def fail(*a, **k):
+        raise OSError("network down")
+
+    monkeypatch.setattr(tgbot, "_send", fail)
+    lock = threading.Lock()
+    with pytest.raises(OSError):
+        tgbot._handle("t", "1", "/sync", lock)
+    assert not lock.locked()
+
+
+def test_refuses_to_start_without_token_or_chat(monkeypatch):
+    monkeypatch.delenv("TELEGRAM_BOT_TOKEN", raising=False)
+    monkeypatch.delenv("TELEGRAM_CHAT_ID", raising=False)
+    assert tgbot.run_tg_bot() == 2
+    monkeypatch.setenv("TELEGRAM_BOT_TOKEN", "123:abc")
+    assert tgbot.run_tg_bot() == 2
+
+
+def test_poll_loop_allowlist_and_start_vs_startloop(monkeypatch, sent):
+    monkeypatch.setenv("TELEGRAM_BOT_TOKEN", "123:abc")
+    monkeypatch.setenv("TELEGRAM_CHAT_ID", "42, 43")
+    handled = []
+    monkeypatch.setattr(tgbot, "_handle", lambda token, chat, text, lock: handled.append((chat, text)))
+
+    def upd(i, chat, text):
+        return {"update_id": i, "message": {"chat": {"id": chat}, "text": text}}
+
+    polls = [
+        {"result": [
+            upd(1, 999, "/status"),         # stranger: silently ignored
+            upd(2, 42, "/start"),           # welcome only
+            upd(3, 42, "/start@MyBot"),     # welcome only
+            upd(4, 42, "/startloop"),       # must reach _handle
+            upd(5, 43, "/status"),
+        ]},
+    ]
+
+    def fake_api(token, method, payload=None, timeout=35):
+        if method == "getMe":
+            return {"ok": True, "result": {"username": "mybot"}}
+        if method == "getUpdates":
+            if polls:
+                return polls.pop(0)
+            raise KeyboardInterrupt
+        return {"ok": True}
+
+    monkeypatch.setattr(tgbot, "_api", fake_api)
+    assert tgbot.run_tg_bot() == 0
+    assert handled == [("42", "/startloop"), ("43", "/status")]
+    assert [c for c, _ in sent] == ["42", "42"] and all("ready" in t for _, t in sent)
