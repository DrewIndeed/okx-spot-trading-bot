# Copy to .env and fill in locally. Never commit .env or real keys.
# The engine reads these from the environment. YAML config must not contain them.

# Required only for live mode. Use a trade-only key with withdraw DISABLED.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Required together with: okxspot live --enable-live
# The value must match exactly.
OKX_LIVE_CONFIRM=

# Optional alerts. Leave blank to log alerts locally.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional alias of the live confirm value (I_ACCEPT). The primary confirm is OKX_LIVE_CONFIRM.
LIVE_CONFIRM=

# OKX demo-trading key (read+trade, no withdraw). Enter via the secret form, never chat.
OKX_DEMO_API_KEY=
OKX_DEMO_API_SECRET=
OKX_DEMO_API_PASSPHRASE=
